---
interface Props { testimonials: any; }
const { testimonials } = Astro.props;
---
<section class="section tst center">
  <div class="wrap">
    <p class="eyebrow eyebrow--on-dark reveal">{testimonials.eyebrow}</p>
    <h2 class="reveal">{testimonials.title}</h2>
    <ul class="tst__grid">
      {testimonials.items.map((t: any) => (
        <li class="reveal">
          <figure>
            <blockquote><p>{t.quote}</p></blockquote>
            <figcaption>
              <span class="tst__name">{t.name}</span>
              <span class="tst__role">{t.role}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .tst { background: var(--deep); color: var(--cream-on-dark); }
  h2 { font-size: var(--fs-h2); color: var(--paper); }
  .tst__grid {
    list-style: none; padding: 0; margin: clamp(2.5rem, 5vw, 3.75rem) 0 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem);
    text-align: left;
  }
  .tst__grid li + li { border-left: 1px solid var(--hairline); padding-left: clamp(1.5rem, 3vw, 2.5rem); }
  figure { margin: 0; height: 100%; display: flex; flex-direction: column; }
  blockquote { margin: 0 0 auto; }
  blockquote p {
    font-family: var(--font-display); font-variation-settings: var(--fv-text);
    font-size: 1rem; line-height: 1.62; opacity: 0.86;
  }
  figcaption { margin-top: 1.6rem; }
  .tst__name { display: block; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.05em; color: var(--gold); }
  .tst__role { display: block; font-size: 0.78rem; opacity: 0.6; margin-top: 0.15rem; }
  @media (max-width: 560px) {
    blockquote p { font-size: 0.96rem; }
    figcaption { margin-top: 1.1rem; }
  }
  @media (max-width: 860px) {
    .tst__grid { grid-template-columns: 1fr; }
    .tst__grid li + li { border-left: 0; padding-left: 0; border-top: 1px solid var(--hairline); padding-top: 1.75rem; }
  }
</style>
