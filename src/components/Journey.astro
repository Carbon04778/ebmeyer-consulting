---
interface Props { journey: any; }
const { journey } = Astro.props;
---
<section class="section jn center">
  <div class="wrap">
    <p class="eyebrow reveal">{journey.eyebrow}</p>
    <h2 class="reveal">{journey.title}</h2>
    <p class="lead reveal">{journey.lead}</p>
    <ol class="jn__steps">
      {journey.steps.map((s: any, i: number) => (
        <li class:list={['reveal', s.highlight && 'is-hl']}>
          <p class="jn__label">{s.label}</p>
          <h3>{s.name}</h3>
          <p class="jn__dur">{s.duration}</p>
          <p class="jn__body">{s.body}</p>
        </li>
      ))}
    </ol>
    <p class="jn__pull serif-italic reveal">{journey.pull}</p>
    <p class="jn__note reveal">{journey.note}</p>
  </div>
</section>
<style>
  .jn { background: var(--paper); }
  h2 { font-size: var(--fs-h2); max-width: 22ch; margin-inline: auto; margin-bottom: 1.5rem; }
  .jn__steps {
    list-style: none; padding: 0; margin: clamp(2.25rem, 4vw, 3rem) 0 0;
    display: grid; gap: 1.25rem; text-align: left;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
  }
  .jn__steps li {
    border: 1px solid var(--hairline); border-radius: var(--radius-sm);
    padding: clamp(1.35rem, 2.5vw, 1.85rem); background: #fff6;
  }
  .is-hl { border-color: color-mix(in srgb, var(--magenta) 40%, transparent); background: color-mix(in srgb, var(--magenta) 6%, #fff); }
  .jn__label {
    font-size: 0.66rem; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--gold); margin-bottom: 0.6rem;
  }
  .is-hl .jn__label { color: var(--magenta); }
  h3 { font-size: 1.32rem; font-variation-settings: var(--fv-text); margin-bottom: 0.35rem; }
  .jn__dur {
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--gold); margin-bottom: 0.8rem;
  }
  .jn__body { font-size: 0.9rem; color: var(--ink-soft); margin: 0; }
  .jn__pull {
    font-size: clamp(1.15rem, 2.4vw, 1.5rem); line-height: 1.45;
    margin: clamp(2rem, 4vw, 2.75rem) auto 0.75rem; max-width: 30ch;
  }
  .jn__note { font-size: 0.85rem; color: var(--ink-mute); margin: 0; }
  @media (max-width: 560px) {
    .jn__steps li { padding: 1.15rem 1.1rem; }
    h3 { font-size: 1.2rem; }
    .jn__pull { max-width: none; }
  }
</style>
