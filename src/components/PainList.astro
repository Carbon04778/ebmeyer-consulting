---
interface Props { pain: any; }
const { pain } = Astro.props;
---
<section class="section pain">
  <div class="wrap">
    <p class="eyebrow reveal">{pain.eyebrow}</p>
    <h2 class="reveal">{pain.title}</h2>
    <hr class="rule" />
    <ol class="pain__list">
      {pain.items.map((i: any) => (
        <li class="reveal">
          <span class="pain__num num">{i.num}</span>
          <div>
            <h3>{i.title}</h3>
            <p>{i.body}</p>
          </div>
        </li>
      ))}
    </ol>
    <blockquote class="pain__pull reveal"><p>{pain.pull}</p></blockquote>
  </div>
</section>
<style>
  .pain { background: var(--paper); }
  h2 { font-size: var(--fs-h2); max-width: 20ch; margin-bottom: 2rem; }
  .pain__list { list-style: none; margin: 0; padding: 0; }
  .pain__list li { display: grid; grid-template-columns: 4rem 1fr; gap: 0.5rem; padding: 1.4rem 0; }
  .pain__num { font-size: 1.35rem; color: var(--gold); }
  h3 { font-size: 1.18rem; font-variation-settings: var(--fv-text); margin-bottom: 0.4rem; }
  .pain__list p { color: var(--ink-soft); font-size: 0.95rem; max-width: 62ch; }
  .pain__pull {
    margin: 2rem 0 0; padding: 1.5rem 1.9rem;
    background: color-mix(in srgb, var(--magenta) 8%, var(--paper));
    border-left: 3px solid var(--gold); border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .pain__pull p {
    font-family: var(--font-display); font-variation-settings: var(--fv-text);
    font-style: italic; font-size: 1.1rem; max-width: 58ch;
  }
  @media (max-width: 560px) {
    .pain__list li { grid-template-columns: 1fr; gap: 0.15rem; padding: 1.1rem 0; }
    .pain__num { font-size: 1.05rem; }
    .pain__pull { padding: 1.15rem 1.25rem; }
    .pain__pull p { font-size: 1rem; }
  }
</style>
