---
interface Props { phase: any; index: number; }
const { phase, index } = Astro.props;
---
<section class:list={['section pd', index % 2 === 1 && 'is-alt']}>
  <div class="wrap">
    <p class="eyebrow reveal">{phase.eyebrow}</p>
    <h2 class="reveal">
      {phase.title}
      <span class="pd__dur serif-italic">· {phase.duration}</span>
    </h2>
    <p class="pd__sub serif-italic reveal">{phase.sub}</p>
    <hr class="rule" />
    <div class="pd__cols">
      <div class="pd__left reveal">
        <h3>{phase.gainsTitle}</h3>
        <ul class="pd__gains">
          {phase.gains.map((g: string) => (
            <li>
              <svg width="16" height="10" viewBox="0 0 16 10" fill="none" aria-hidden="true">
                <path d="M0 5h14M10 1l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{g}</span>
            </li>
          ))}
        </ul>
        <h3 class="pd__h-mag">{phase.formatTitle}</h3>
        <p class="pd__p">{phase.format}</p>
        <h3 class="pd__h-mag">{phase.idealTitle}</h3>
        <p class="pd__p">{phase.ideal}</p>
      </div>
      <div class="pd__right reveal">
        <h3 class="pd__h-mag">{phase.resultsTitle}</h3>
        <dl>
          {phase.results.map((r: any) => (
            <div class="pd__res">
              <dt>{r.term}</dt>
              <dd>{r.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
    {phase.glossary && (
      <p class="pd__gloss reveal">
        <strong>Kurz erklärt:</strong> {phase.glossary}
      </p>
    )}
  </div>
</section>
<style>
  .pd { background: var(--paper); }
  .pd.is-alt { background: var(--warm); }
  h2 { font-size: var(--fs-h3); }
  .pd__dur { font-weight: 400; }
  .pd__sub { font-size: clamp(1rem, 2vw, 1.18rem); color: var(--ink-soft); margin-top: 0.6rem; }
  .pd__cols {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem); align-items: start;
  }
  .pd__right { border-left: 1px solid var(--hairline); padding-left: clamp(1.5rem, 4vw, 3rem); }
  h3 {
    font-family: var(--font-sans); font-size: 0.72rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--gold); margin: 0 0 1rem;
  }
  .pd__h-mag { color: var(--magenta); margin-top: 2rem; }
  .pd__gains { list-style: none; padding: 0; margin: 0; }
  .pd__gains li { display: grid; grid-template-columns: 1.6rem 1fr; gap: 0.5rem; padding: 0.45rem 0; align-items: start; }
  .pd__gains svg { color: var(--gold); margin-top: 0.5rem; }
  .pd__p { color: var(--ink-soft); font-size: 0.94rem; max-width: 44ch; }
  .pd__res { padding: 0.95rem 0; border-top: 1px solid var(--hairline); }
  .pd__res:first-of-type { border-top: 0; padding-top: 0; }
  dt {
    font-family: var(--font-display); font-variation-settings: var(--fv-text);
    font-weight: 600; font-size: 1.05rem; margin-bottom: 0.3rem;
  }
  dd { margin: 0; font-size: 0.9rem; color: var(--ink-soft); }
  .pd__gloss {
    margin-top: 2.5rem; padding-top: 1.1rem; border-top: 1px solid var(--hairline);
    font-size: 0.82rem; color: var(--ink-mute);
  }
  .pd__gloss strong { color: var(--magenta); letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.72rem; }
  @media (max-width: 760px) {
    .pd__cols { grid-template-columns: 1fr; }
    .pd__right { border-left: 0; padding-left: 0; border-top: 1px solid var(--hairline); padding-top: 1.75rem; }
  }
  @media (max-width: 560px) {
    h2 { font-size: 1.6rem; }
    .pd__dur { display: block; font-size: 1.15rem; margin-top: 0.2rem; }
    .pd__p { max-width: none; }
    .pd__gains li { grid-template-columns: 1.2rem 1fr; gap: 0.4rem; }
    .pd__gains svg { width: 13px; margin-top: 0.45rem; }
    .pd__h-mag { margin-top: 1.6rem; }
  }
</style>
