  <p>
    Legal form: {site.legal.legalFormEn}<br />
    Owner: {site.legal.owner}<br />
    UID number: {site.legal.uid}
  </p>
  <p>{site.legal.vatEn}</p>
  <h2>Disclaimer</h2>
