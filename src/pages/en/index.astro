---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import SplitPanel from '../../components/SplitPanel.astro';
import Stats from '../../components/Stats.astro';
import About from '../../components/About.astro';
import Results from '../../components/Results.astro';
import Testimonials from '../../components/Testimonials.astro';
import Gallery from '../../components/Gallery.astro';
import Bio from '../../components/Bio.astro';
import CallToAction from '../../components/CallToAction.astro';
import Footer from '../../components/Footer.astro';
import t from '../../data/en.json';
---
<Base locale="en" title={t.meta.title} description={t.meta.description} path="" altPath="">
  <Header overlay locale="en" nav={t.nav} altHref="/de/" />
  <main id="main">
    <Hero hero={t.hero} />
    <SplitPanel label={t.splitLabel} programs={t.programs} />
    <Stats stats={t.stats} />
    <About about={t.about} />
    <Results results={t.results} />
    <Testimonials testimonials={t.testimonials} />
    <Gallery gallery={t.gallery} />
    <Bio bio={t.bio} />
    <CallToAction cta={t.cta} />
  </main>
  <Footer footer={t.footer} locale="en" />
</Base>
