# ebmeyer-consulting.ch — Apache config for Hostpoint (or any Apache host).
# Vercel ignores this file, so it is safe to ship regardless of where the
# site is deployed. Replaces what Vercel did implicitly: canonical host,
# HTTPS, a real 404, long cache on hashed assets, and a few safety headers.

# --- Canonical host: https://ebmeyer-consulting.ch (no www) ---
# Matches `site` in astro.config.mjs and every canonical/hreflang tag.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Not found ---
# Astro builds src/pages/404.astro to /404.html.
ErrorDocument 404 /404.html

# --- Caching ---
# /_astro/* files carry a content hash in the name: cache forever.
# HTML must revalidate so a deploy is visible immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|webp|avif|svg|png|jpg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # --- Safety headers ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Compression (Hostpoint enables this server-side; harmless if repeated) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Hygiene ---
Options -Indexes
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
